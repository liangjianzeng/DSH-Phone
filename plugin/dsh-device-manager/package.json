{
  "name": "@local/dsh-device-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Android 测试机（adb）管理：主机扫描 USB / 局域网 / Tailscale 上可连设备，顶栏面板看状态并把调试消息注入会话。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/adb.js",
    "lib/args.js",
    "lib/probe.js",
    "lib/registry.js",
    "lib/scan.js",
    "lib/templates.js",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
